---
import LessonLayout from "./LessonLayout.astro";
import { getCollection } from "astro:content";

const { frontmatter } = Astro.props;
const allLessons = await getCollection("informatica");

const lessons = allLessons.reduce((acc, entry) => {
  const subject = entry.data.subject || "Generale";
  if (!acc[subject]) acc[subject] = [];
  acc[subject].push({
    title: entry.data.title,
    url: `/${entry.collection}/${entry.slug}`,
    order: entry.data.order ?? 0,
    draft: entry.data.draft,
    subject: subject
  });
  return acc;
}, {});
---

<LessonLayout frontmatter={frontmatter} lessons={lessons} backHref="/informatica" sectionName="Informatica">
  <slot />
</LessonLayout>
