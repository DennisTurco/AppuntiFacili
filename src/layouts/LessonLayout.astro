---
import { Icon } from "astro-icon/components";
import Layout from "./Layout.astro";
import { getFormattedDate } from "@/utils/all";
import LessonSearch from "../components/LessonSearch";
import ScrollOnTop from "../components/ScrollOnTop";
import BackButton from "../components/BackButton.astro";
import BookLessonButton from "../components/BookLessonButton.astro";
import GoToTopButton from "../components/GoToTopButton.astro";
import ActionButtons from "../components/ActionButtons.astro";
import TableOfContents from "../components/TableOfContents.astro";

type LessonItem = {
  title: string;
  url: string;
  order?: number;
  subject?: string;
  draft: boolean;
};

type LessonSubject = {
  subject: string;
  lessons: LessonItem[];
};

interface LessonLayoutProps {
  frontmatter: any;
  lessons: Record<string, LessonItem[]>;
  backHref?: string;
  sectionName?: string;
}

// **Tipizza Astro.props**
const { frontmatter, lessons, backHref = "/", sectionName = "Sezione" } =
  Astro.props as LessonLayoutProps;

// Filtra le lezioni non pubblicate (draft === true)
const filteredLessonsArray: LessonSubject[] = Object.entries(lessons)
  .map(([subject, lessonList]) => ({
    subject,
    lessons: lessonList
      .filter(lesson => !lesson.draft) // <-- filtra draft
      .sort((a, b) => (a.order ?? 0) - (b.order ?? 0)),
  }))
  .filter(subject => subject.lessons.length > 0) // rimuove soggetti senza lezioni
  .sort((a, b) => a.subject.localeCompare(b.subject));

// Flatten per prev/next
const flatLessons: LessonItem[] = filteredLessonsArray.flatMap(l => l.lessons);
const currentIndex = flatLessons.findIndex(l => l.url === frontmatter.url);

const prevLesson = currentIndex > 0 ? flatLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < flatLessons.length - 1 ? flatLessons[currentIndex + 1] : null;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  url={frontmatter.url}
  image={frontmatter.image}
>
<div class="w-full max-w-[2000px] flex flex-col lg:flex-row mx-6 mt-14 px-2 lg:px-4 gap-6">

    <!-- Sidebar lezioni -->
    {filteredLessonsArray.length > 0 && (
      <aside class="hidden lg:block w-64 sticky top-20 h-[calc(100vh-80px)] overflow-y-auto border-r border-gray-200 pr-4">
  <h2 class="text-xl font-bold mb-4">Lezioni</h2>

  <input
    type="text"
    placeholder="Cerca..."
    id="lesson-search"
    class="w-full mb-4 px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-400"
  />

  <div id="lessons-list" class="space-y-2">
    {filteredLessonsArray.map(({ subject, lessons }) => (
      <details
        class="group border border-gray-100 rounded-md overflow-hidden"
        open={frontmatter.subject === subject}
      >
        <summary
          class="px-3 py-2 cursor-pointer font-semibold bg-gray-50 hover:bg-gray-100 flex justify-between items-center"
        >
          {subject}
          <Icon
            name="fa6-solid:chevron-right"
            class="transition-transform duration-200 group-open:rotate-90 text-gray-500"
          />
        </summary>
        <ul class="pl-4 py-2 space-y-1">
          {lessons.map((lesson) => (
            <li>
              <a
                href={lesson.url}
                class={`block px-2 py-1 rounded hover:bg-gray-100 transition
                  ${lesson.url === frontmatter.url ? "bg-gray-200 font-semibold" : ""}`}
              >
                {lesson.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</aside>
    )}

    <!-- Contenuto principale + TOC -->
    <div class="flex flex-1 gap-8">
      <!-- Contenuto centrale -->
      <div class="prose prose-lg max-w-full flex-1" id="lesson-content">
        <div class="mb-6">
          <ActionButtons href={backHref} />

          <nav class="text-sm text-gray-500 mb-4">
            <a href={backHref} class="hover:underline">{sectionName}</a>
            {frontmatter.subject && <> › {frontmatter.subject}</>}
            {" "}› {frontmatter.title}
          </nav>

          <h1 class="text-5xl font-extrabold tracking-tight">{frontmatter.title}</h1>

          <div class="mt-3 flex flex-wrap items-center gap-x-3 text-sm text-gray-600">
            <span class="flex items-center gap-1">✍️ <span class="font-medium">{frontmatter.author}</span></span>
            {frontmatter.category && <span class="flex items-center gap-1">🏷️ <span>{frontmatter.category}</span></span>}
            {frontmatter.subject && <span class="flex items-center gap-1">📘 <span>{frontmatter.subject}</span></span>}
          </div>

          {frontmatter.lastUpdateDate && (
            <div class="mt-1 text-xs text-gray-400 italic">
              Ultima modifica: <time datetime={frontmatter.lastUpdateDate}>{getFormattedDate(frontmatter.lastUpdateDate)}</time>
            </div>
          )}

          {frontmatter.tags?.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {frontmatter.tags.map(tag => (
                <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200 transition">#{tag}</span>
              ))}
            </div>
          )}

          {frontmatter.videoLesson && (
            <div class="mt-6">
              <a
                href="/videolezioni"
                class="inline-flex items-center gap-2 rounded-lg bg-sky-500 px-4 py-2 text-sm font-semibold text-white shadow-md transition hover:bg-sky-600 no-underline"
              >
                🎥 Guarda la videolezione
              </a>
            </div>
          )}
        </div>

        <!-- Contenuto MD/MDX -->
        <slot />

        {(prevLesson || nextLesson) && (
  <div class="mt-12 flex justify-between gap-4">
    {prevLesson ? (
      <a
        href={prevLesson.url}
        class="flex-1 border border-gray-300 rounded-lg px-4 py-3 hover:bg-gray-100 transition flex items-center no-underline"
      >
        <span class="text-xl mr-3">←</span>
        <div class="flex flex-col">
          <span class="text-xs text-gray-500">Precedente</span>
          <span class="font-semibold text-gray-800 truncate">{prevLesson.title}</span>
        </div>
      </a>
    ) : <div class="flex-1" />}

    {nextLesson ? (
      <a
        href={nextLesson.url}
        class="flex-1 border border-gray-300 rounded-lg px-4 py-3 hover:bg-gray-100 transition flex items-center justify-end no-underline"
      >
        <div class="flex flex-col items-end">
          <span class="text-xs text-gray-500">Successiva</span>
          <span class="font-semibold text-gray-800 truncate">{nextLesson.title}</span>
        </div>
        <span class="text-xl ml-3">→</span>
      </a>
    ) : <div class="flex-1" />}
  </div>
)}

        <GoToTopButton />
        <BookLessonButton />
      </div>

      <!-- Table of Contents -->
      <div class="hidden lg:block w-64">
        <TableOfContents />
      </div>
    </div>
  </div>

  <BackButton href={backHref} />
  <LessonSearch client:load />
  <ScrollOnTop client:load />
</Layout>
