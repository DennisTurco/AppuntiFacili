---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import Donation from "@/components/donation.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import { ViewTransitions } from 'astro:transitions';
import ToasterProvider from "@/components/ToasterProvider.jsx";
import "../styles/global.css";
import CopyToClipboard from "../components/CopyToClipboard";

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = "https://appuntifacili.it/_astro/logo.C8GkM4Tb_Z2tB72M.webp";

const { title, description, url, image } = Astro.props as Props;

const makeTitle = title
  ? title + " | " + "AppuntiFacili"
  : "AppuntiFacili";

export interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />
    <!-- Anti-FOUC: apply theme before first paint -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <!-- View Transitions: preserve dark class across page swaps -->
    <script>
      document.addEventListener('astro:before-swap', (e) => {
        // Copy the current theme class to the incoming document before the DOM swap.
        // Without this, Astro replaces <html> with the new page's <html> (no class="dark")
        // and the theme is lost on every navigation.
        if (document.documentElement.classList.contains('dark')) {
          e.newDocument.documentElement.classList.add('dark');
        } else {
          e.newDocument.documentElement.classList.remove('dark');
        }
      });
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"/>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      title={makeTitle}
      description="Appunti chiari e pratici di matematica e programmazione: riassunti, esercizi e videolezioni per studenti di superiori e università, aggiornati su richiesta.";
      canonical={canonicalURL}
      twitter={{
        creator: "@surjithctly",
        site: "@web3templates",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `AppuntiFacili`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "AppuntiFacili Homepage Screenshot",
        },
      }}
    />

    <!-- Google tag (gtag.js) -->
    <script type="text/partytown" async src={`https://www.googletagmanager.com/gtag/js?id=G-GSE1MKHYSG`}></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GSE1MKHYSG');
    </script>

    <!-- Copy code to clipboard -->
    <CopyToClipboard client:load />

    <!-- Mermaid diagram renderer -->
    <script>
      // astro:page-load fires on the initial page load AND after every
      // View Transition swap, so we never miss diagrams regardless of
      // which page the user lands on first.
      document.addEventListener('astro:page-load', async () => {
        const diagrams = document.querySelectorAll('pre.mermaid:not([data-processed])');
        if (diagrams.length === 0) return;

        const { default: mermaid } = await import('mermaid');

        const isDark = document.documentElement.classList.contains('dark');

        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'base' : 'forest',
          flowchart: { curve: 'basis' },
          themeVariables: isDark ? {
            // Dark mode: colori completamente espliciti per garantire leggibilità
            background:                   '#1e293b',
            mainBkg:                      '#1e293b',
            nodeBorder:                   '#60a5fa',
            clusterBkg:                   '#0f172a',
            titleColor:                   '#f1f5f9',
            edgeLabelBackground:          '#1e293b',
            primaryColor:                 '#1d4ed8',
            primaryTextColor:             '#f1f5f9',
            primaryBorderColor:           '#60a5fa',
            secondaryColor:               '#0f172a',
            secondaryTextColor:           '#f1f5f9',
            secondaryBorderColor:         '#94a3b8',
            tertiaryColor:                '#0f172a',
            tertiaryTextColor:            '#f1f5f9',
            tertiaryBorderColor:          '#94a3b8',
            lineColor:                    '#94a3b8',
            textColor:                    '#f1f5f9',
            labelColor:                   '#f1f5f9',
            labelTextColor:               '#f1f5f9',
            loopTextColor:                '#f1f5f9',
            noteBkgColor:                 '#1e3a5f',
            noteTextColor:                '#f1f5f9',
            noteBorderColor:              '#60a5fa',
            activationBkgColor:           '#1d4ed8',
            activationBorderColor:        '#60a5fa',
            sequenceNumberColor:          '#f1f5f9',
            actorBkg:                     '#1e293b',
            actorBorder:                  '#60a5fa',
            actorTextColor:               '#f1f5f9',
            actorLineColor:               '#94a3b8',
            signalColor:                  '#94a3b8',
            signalTextColor:              '#f1f5f9',
            fillType0:                    '#1d4ed8',
            fillType1:                    '#0f172a',
            fillType2:                    '#1e293b',
            fillType3:                    '#172554',
            fillType4:                    '#1e3a5f',
            fillType5:                    '#0c4a6e',
            fillType6:                    '#164e63',
            fillType7:                    '#134e4a',
            attributeBackgroundColorEven: '#1e293b',
            attributeBackgroundColorOdd:  '#0f172a',
          } : {
            background: '#ffffff',
          },
        });

        for (const diagram of diagrams) {
          const definition = diagram.textContent ?? '';
          const id = 'mermaid-' + Math.random().toString(36).slice(2, 11);
          try {
            const { svg } = await mermaid.render(id, definition);
            diagram.innerHTML = svg;
            diagram.setAttribute('data-processed', 'true');
            diagram.classList.add('mermaid-container');
          } catch (err) {
            console.error('[mermaid] render error:', err);
            diagram.innerHTML = `<pre style="color:red;border:1px solid red;padding:.5rem">${err}</pre>`;
            diagram.setAttribute('data-processed', 'true');
          }
        }
      });
    </script>

  </head>
  <body class="bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 transition-colors duration-200">
    <Donation />
    <Navbar />
    <ToasterProvider client:load>
    <slot />
    </ToasterProvider>
    <ViewTransitions />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>