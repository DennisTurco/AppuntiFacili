---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import Donation from "@/components/donation.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import { ClientRouter } from "astro:transitions";
import ToasterProvider from "@/components/ToasterProvider.jsx";
import "../styles/global.css";
import logo from "@/assets/logo/logo.webp";

export interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
}

const DEFAULT_DESCRIPTION =
  "Appunti chiari e pratici di matematica e programmazione: riassunti, esercizi e videolezioni per studenti di superiori e università, aggiornati su richiesta.";

const { title, description, image } = Astro.props as Props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image ?? logo.src, Astro.site).toString();
const makeTitle = title ? `${title} | AppuntiFacili` : "AppuntiFacili";
const metaDescription = description || DEFAULT_DESCRIPTION;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <!-- Anti-FOUC: apply theme before first paint -->
    <script is:inline>
      (function() {
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <!-- View Transitions: preserve dark class across page swaps -->
    <script>
      document.addEventListener('astro:before-swap', (e) => {
        // Copy the current theme class to the incoming document before the DOM swap.
        // Without this, Astro replaces <html> with the new page's <html> (no class="dark")
        // and the theme is lost on every navigation.
        if (document.documentElement.classList.contains('dark')) {
          e.newDocument.documentElement.classList.add('dark');
        } else {
          e.newDocument.documentElement.classList.remove('dark');
        }
      });
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={canonicalURL}
      twitter={{
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: ogImage,
        },
        optional: {
          description: metaDescription,
          locale: "it_IT",
          siteName: "AppuntiFacili",
        },
        image: {
          alt: "AppuntiFacili",
        },
      }}
    />

    <!-- Google tag (gtag.js) -->
    <script type="text/partytown" async src={`https://www.googletagmanager.com/gtag/js?id=G-GSE1MKHYSG`}></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GSE1MKHYSG');
    </script>

    <ClientRouter />

    <!-- Copy code to clipboard -->
    <script>
      const COPY_LABEL = "Copia";
      const COPIED_LABEL = "Copiato!";

      document.addEventListener('astro:page-load', () => {
        const codeBlocks = document.querySelectorAll<HTMLPreElement>('pre:not(.mermaid)');

        for (const codeBlock of codeBlocks) {
          const codeEl = codeBlock.querySelector('code');
          if (!codeEl || !codeBlock.parentNode) continue;
          if (codeBlock.parentElement?.classList.contains('code-wrapper')) continue;
          if (codeEl.className.toLowerCase().includes('mermaid')) continue;
          // Blocchi gestiti da componenti React (es. codice nei quiz): non vanno spostati
          if (codeBlock.closest('[data-no-copy]')) continue;

          const wrapper = document.createElement('div');
          wrapper.className = 'code-wrapper';
          wrapper.style.position = 'relative';

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'copy-code';
          button.textContent = COPY_LABEL;
          button.setAttribute('aria-label', 'Copia il codice');

          codeBlock.setAttribute('tabindex', '0');
          codeBlock.parentNode.insertBefore(wrapper, codeBlock);
          wrapper.appendChild(codeBlock);
          wrapper.appendChild(button);

          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(codeEl.textContent ?? '');
              button.textContent = COPIED_LABEL;
              button.dataset.copied = '';
              setTimeout(() => {
                button.textContent = COPY_LABEL;
                delete button.dataset.copied;
              }, 1500);
            } catch (err) {
              console.error('Failed to copy:', err);
            }
          });
        }
      });
    </script>

    <!-- Mermaid diagram renderer -->
    <script>
      // astro:page-load fires on the initial page load AND after every
      // View Transition swap, so we never miss diagrams regardless of
      // which page the user lands on first.
      async function renderMermaid() {
        const diagrams = document.querySelectorAll<HTMLElement>('pre.mermaid:not([data-processed])');
        if (diagrams.length === 0) return;

        const { default: mermaid } = await import('mermaid');

        const isDark = document.documentElement.classList.contains('dark');

        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'base' : 'forest',
          flowchart: { curve: 'basis' },
          themeVariables: isDark ? {
            // Dark mode: colori completamente espliciti per garantire leggibilità
            background:                   '#1e293b',
            mainBkg:                      '#1e293b',
            nodeBorder:                   '#60a5fa',
            clusterBkg:                   '#0f172a',
            titleColor:                   '#f1f5f9',
            edgeLabelBackground:          '#1e293b',
            primaryColor:                 '#1d4ed8',
            primaryTextColor:             '#f1f5f9',
            primaryBorderColor:           '#60a5fa',
            secondaryColor:               '#0f172a',
            secondaryTextColor:           '#f1f5f9',
            secondaryBorderColor:         '#94a3b8',
            tertiaryColor:                '#0f172a',
            tertiaryTextColor:            '#f1f5f9',
            tertiaryBorderColor:          '#94a3b8',
            lineColor:                    '#94a3b8',
            textColor:                    '#f1f5f9',
            labelColor:                   '#f1f5f9',
            labelTextColor:               '#f1f5f9',
            loopTextColor:                '#f1f5f9',
            noteBkgColor:                 '#1e3a5f',
            noteTextColor:                '#f1f5f9',
            noteBorderColor:              '#60a5fa',
            activationBkgColor:           '#1d4ed8',
            activationBorderColor:        '#60a5fa',
            sequenceNumberColor:          '#f1f5f9',
            actorBkg:                     '#1e293b',
            actorBorder:                  '#60a5fa',
            actorTextColor:               '#f1f5f9',
            actorLineColor:               '#94a3b8',
            signalColor:                  '#94a3b8',
            signalTextColor:              '#f1f5f9',
            fillType0:                    '#1d4ed8',
            fillType1:                    '#0f172a',
            fillType2:                    '#1e293b',
            fillType3:                    '#172554',
            fillType4:                    '#1e3a5f',
            fillType5:                    '#0c4a6e',
            fillType6:                    '#164e63',
            fillType7:                    '#134e4a',
            attributeBackgroundColorEven: '#1e293b',
            attributeBackgroundColorOdd:  '#0f172a',
          } : {
            background: '#ffffff',
          },
        });

        for (const diagram of diagrams) {
          // Conserva il sorgente per poter ridisegnare al cambio tema
          diagram.dataset.source ??= diagram.textContent ?? '';
          const definition = diagram.dataset.source;
          const id = 'mermaid-' + Math.random().toString(36).slice(2, 11);
          try {
            const { svg } = await mermaid.render(id, definition);
            diagram.innerHTML = svg;
            diagram.setAttribute('data-processed', 'true');
            diagram.classList.add('mermaid-container');
          } catch (err) {
            console.error('[mermaid] render error:', err);
            diagram.innerHTML = `<pre style="color:red;border:1px solid red;padding:.5rem">${err}</pre>`;
            diagram.setAttribute('data-processed', 'true');
          }
        }
      }

      document.addEventListener('astro:page-load', renderMermaid);

      // Ridisegna i diagrammi con i colori del nuovo tema
      document.addEventListener('themechange', () => {
        document.querySelectorAll<HTMLElement>('pre.mermaid[data-source]').forEach((diagram) => {
          diagram.removeAttribute('data-processed');
          diagram.textContent = diagram.dataset.source ?? '';
        });
        renderMermaid();
      });
    </script>

  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Vai al contenuto
    </a>
    <Donation />
    <Navbar />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <ToasterProvider client:idle />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
