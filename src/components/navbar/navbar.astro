---
import Container from "@/components/container.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from "astro-icon/components";
import { supabase } from "../../lib/supabaseClient.js";
import UserMenu from "@/components/UserMenu.jsx";
import DarkModeToggle from "@/components/DarkModeToggle";
import type { User } from '@supabase/supabase-js';

// menuitems definiti qui
const menuitems = [
  { title: "Home", path: "/", icon: "fa6-solid:house" },
  {
    title: "Materie",
    path: "#",
    icon: "fa6-solid:book-open",
    children: [
      { title: "Informatica", path: "/informatica" },
      { title: "Matematica", path: "/matematica" },
    ],
  },
  { title: "Insegnanti", path: "/insegnanti", icon: "fa6-solid:chalkboard-user" },
  { title: "Contattami", path: "/contact", icon: "fa6-solid:envelope" },
  { title: "Video Lezioni", badge: true, path: "/videolezioni", icon: "fa6-solid:video" },
  { title: "Portfolio", path: "https://dennisturco.com/", icon: "fa6-solid:briefcase" },
];

let user: User | null = null;

// controlla se l'utente è loggato
const checkUser = async () => {
  const { data } = await supabase.auth.getUser();
  user = data.user;
};

checkUser();

// logout semplice
const logout = async () => {
  await supabase.auth.signOut();
  user = null;
  location.reload(); // ricarica la pagina per aggiornare la navbar
};
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5 bg-white dark:bg-slate-900 transition-colors duration-200">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg">
          <span class="font-bold text-slate-800 dark:text-slate-100">Appunti</span><span class="text-slate-500 dark:text-slate-400">Facili</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800 dark:text-gray-200" />
        </div>
      </div>

      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0 items-center">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    icon={item.icon}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />

                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex items-center gap-1 lg:px-3 py-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors"
                    >
                      {item.icon && (
                        <Icon name={item.icon} class="w-4 h-4 text-gray-500 dark:text-gray-400" />
                      )}
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>

        <div class="flex gap-2 ml-4">
          <UserMenu client:load />
        </div>

        <div class="ml-2 hidden lg:flex items-center gap-1">
          <!-- Dark mode toggle -->
          <DarkModeToggle client:load />

          <!-- Discord -->
          <a
            href="https://discord.com/invite/9Jb4Gt3HhB"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center rounded-md p-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            aria-label="Discord"
          >
            <Icon name="fa6-brands:discord" class="w-5 h-5" />
          </a>
        </div>
      </MenuItems>
    </Astronav>
  </header>
</Container>
