---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import UserMenu from "@/components/UserMenu.jsx";
import DarkModeToggle from "@/components/DarkModeToggle.astro";
import logo from "@/assets/favicon.webp";

const menuitems = [
  { title: "Informatica", path: "/informatica", icon: "fa6-solid:code" },
  { title: "Matematica", path: "/matematica", icon: "fa6-solid:square-root-variable" },
  { title: "Lezioni private", path: "/insegnanti", icon: "fa6-solid:chalkboard-user" },
  { title: "Video lezioni", path: "/videolezioni", icon: "fa6-solid:video" },
  { title: "Contatti", path: "/contact", icon: "fa6-solid:envelope" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (path: string) => pathname === path || pathname.startsWith(path + "/");
---

<header
  class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-950/85"
>
  <nav class="mx-auto flex h-16 max-w-(--breakpoint-xl) items-center justify-between gap-4 px-5" aria-label="Navigazione principale">
    <a href="/" class="flex shrink-0 items-center gap-2 font-display text-lg" aria-label="AppuntiFacili - Home">
      <Image src={logo} alt="" width={28} height={28} class="h-7 w-7 rounded-md" loading="eager" />
      <span>
        <span class="font-bold text-slate-900 dark:text-white">Appunti</span><span class="text-slate-500 dark:text-slate-400">Facili</span>
      </span>
    </a>

    <!-- Desktop -->
    <ul class="hidden items-center gap-1 lg:flex">
      {menuitems.map((item) => (
        <li>
          <a
            href={item.path}
            aria-current={isActive(item.path) ? "page" : undefined}
            class:list={[
              "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
              isActive(item.path)
                ? "bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300"
                : "text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white",
            ]}
          >
            {item.title}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1">
      <div class="hidden lg:block">
        <UserMenu client:idle />
      </div>
      <a
        href="https://discord.com/invite/9Jb4Gt3HhB"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg p-2 text-slate-500 transition-colors hover:bg-slate-100 hover:text-[#5865F2] sm:inline-flex dark:text-slate-400 dark:hover:bg-slate-800"
        aria-label="Discord"
        title="Unisciti al Discord"
      >
        <Icon name="fa6-brands:discord" class="h-5 w-5" />
      </a>
      <DarkModeToggle />

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-button"
        class="inline-flex rounded-lg p-2 text-slate-600 hover:bg-slate-100 lg:hidden dark:text-slate-300 dark:hover:bg-slate-800"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Apri il menu"
      >
        <Icon name="fa6-solid:bars" class="h-5 w-5 menu-open-icon" />
        <Icon name="fa6-solid:xmark" class="hidden h-5 w-5 menu-close-icon" />
      </button>
    </div>
  </nav>

  <!-- Mobile -->
  <div id="mobile-menu" class="hidden border-t border-slate-200 lg:hidden dark:border-slate-800">
    <ul class="mx-auto flex max-w-(--breakpoint-xl) flex-col gap-1 px-5 py-3">
      {menuitems.map((item) => (
        <li>
          <a
            href={item.path}
            aria-current={isActive(item.path) ? "page" : undefined}
            class:list={[
              "flex items-center gap-3 rounded-lg px-3 py-2.5 font-medium",
              isActive(item.path)
                ? "bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300"
                : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800",
            ]}
          >
            <Icon name={item.icon} class="h-4 w-4 opacity-70" />
            {item.title}
          </a>
        </li>
      ))}
      <li class="mt-2 border-t border-slate-200 pt-3 dark:border-slate-800">
        <UserMenu client:idle mobile />
      </li>
    </ul>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    if (!button || !menu) return;

    button.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Chiudi il menu" : "Apri il menu");
      button.querySelector(".menu-open-icon")?.classList.toggle("hidden", open);
      button.querySelector(".menu-close-icon")?.classList.toggle("hidden", !open);
    });
  });
</script>
