---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import insegnante1 from "@/assets/logo/insegnante1.webp";
import insegnante2 from "@/assets/logo/insegnante2.webp";

const teachers = [
  {
    name: "Dennis",
    image: insegnante1,
    subjects: ["Matematica", "Informatica"],
    description: "Lezioni di matematica e informatica: programmazione, algoritmi, database e tutto ciò che trovi negli appunti del sito.",
    href: "/prenotazione-dennis",
  },
  {
    name: "Donatello",
    image: insegnante2,
    subjects: ["Matematica", "Fisica"],
    description: "Lezioni di matematica e fisica.",
    href: "/prenotazione-donatello",
  },
];
---

<div class="mx-auto max-w-5xl py-12 md:py-16">
  <header class="max-w-2xl">
    <p class="eyebrow">Lezioni private</p>
    <h1 class="page-title mt-2">I nostri insegnanti</h1>
    <p class="page-subtitle">
      Lezioni individuali in presenza a Fidenza (PR) oppure a distanza su Discord. Scegli l'insegnante e prenota
      direttamente dal calendario.
    </p>
  </header>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {teachers.map((t) => (
      <article class="card flex flex-col overflow-hidden">
        <Image
          src={t.image}
          alt={`Foto di ${t.name}`}
          width={600}
          height={600}
          class="aspect-[4/3] w-full object-cover"
        />
        <div class="flex flex-1 flex-col p-6">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{t.name}</h2>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {t.subjects.map((s) => (
              <li class="badge bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-600/20 dark:bg-blue-950/60 dark:text-blue-300 dark:ring-blue-400/20">
                {s}
              </li>
            ))}
          </ul>
          <p class="mt-4 flex-1 text-slate-600 dark:text-slate-400">{t.description}</p>
          <a href={t.href} class="btn btn-lg btn-primary mt-6">
            <Icon name="fa6-solid:calendar" class="h-4 w-4" />
            Prenota con {t.name}
          </a>
        </div>
      </article>
    ))}
  </div>

  <p class="mt-10 text-center text-sm text-slate-500 dark:text-slate-400">
    Puoi aggiungere la <a href="/servizi" class="link">trascrizione della lezione</a> e ripassare con DailyPill.
    Hai domande prima di prenotare? <a href="/contact" class="link">Scrivici</a>.
  </p>
</div>
