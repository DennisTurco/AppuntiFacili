---
title: "Insegnanti";
import insegnate1 from "@/assets/logo/insegnante1.webp";
import insegnate2 from "@/assets/logo/insegnante2.webp";
---

<div class="container mx-auto px-6 py-12 space-y-12">
  <h1 class="text-4xl font-bold text-center mb-8">I Nostri Insegnanti</h1>

  <div class="grid grid-cols-1 md:grid-cols-1 gap-8">
    {/* Card Dennis */}
    <div
      class="bg-white shadow-xl rounded-2xl overflow-hidden flex flex-col md:flex-row">
      {/* Immagine */}
      <div class="w-64 aspect-square overflow-hidden mx-auto md:mx-0">
        <img
          src={insegnate1.src}
          alt="Dennis"
          class="w-full h-full object-cover"
        />
      </div>
      {/* Contenuto */}
      <div class="p-6 flex flex-col justify-between text-center md:text-left">
        <div>
          <h2 class="text-2xl font-semibold mb-2">Dennis</h2>
          <p class="text-gray-700 mb-4">
            Dennis insegna <b>matematica</b> ed <b>informatica</b>.
          </p>
        </div>
        <a
          href="/prenotazione-dennis"
          target="_blank"
          class="inline-block bg-blue-600 text-white px-4 py-2 rounded-xl hover:bg-blue-700 transition text-center">
          📅 Prenota una lezione
        </a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-1 gap-8">
    {/* Card Donatello */}
    <div
      class="bg-white shadow-xl rounded-2xl overflow-hidden flex flex-col md:flex-row">
      {/* Immagine */}
      <div class="w-64 aspect-square overflow-hidden mx-auto md:mx-0">
        <img
          src={insegnate2.src}
          alt="Donatello"
          class="w-full h-full object-cover"
        />
      </div>
      {/* Contenuto */}
      <div class="p-6 flex flex-col justify-between text-center md:text-left">
        <div>
          <h2 class="text-2xl font-semibold mb-2">Donatello</h2>
          <p class="text-gray-700 mb-4">
            Donatello insegna <b>matematica</b> ed <b>fisica</b>.
          </p>
        </div>
        <a
          href="/prenotazione-donatello"
          target="_blank"
          class="inline-block bg-blue-600 text-white px-4 py-2 rounded-xl hover:bg-blue-700 transition text-center">
          📅 Prenota una lezione
        </a>
      </div>
    </div>
  </div>


</div>
