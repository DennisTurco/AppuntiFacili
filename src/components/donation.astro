<div
  id="donation-banner"
  class="relative border-b border-blue-100 bg-blue-50 text-blue-900 dark:border-blue-950 dark:bg-blue-950/40 dark:text-blue-100"
>
  <div class="mx-auto flex max-w-(--breakpoint-xl) items-center justify-center gap-x-3 gap-y-1 px-12 py-2 text-center text-sm flex-wrap">
    <p>
      Ti sono utili questi appunti? Sostieni <strong>AppuntiFacili</strong> con una piccola donazione.
    </p>
    <a
      href="https://www.paypal.com/donate/?hosted_button_id=M7CJXS929334U"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 font-semibold underline decoration-blue-400/50 underline-offset-4 hover:decoration-current"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
        <path d="M20.69 6.04c-.23-2.39-2.18-4.04-4.78-4.04H7.05a.76.76 0 0 0-.75.64L3.02 20.86a.37.37 0 0 0 .37.43h4.08l.26-1.45.75-4.18.15-.8a.76.76 0 0 1 .75-.64h1.64c3.57 0 6.56-2.3 7.28-5.69.09-.43.13-.85.11-1.25Zm-2.7 1.45c-.57 2.89-3.05 4.82-6.13 4.82h-2.1a.37.37 0 0 0-.37.31l-1.13 6.3-.2 1.14h3.27c.24 0 .45-.17.5-.4l.06-.3.64-3.54.04-.23a.76.76 0 0 1 .75-.64h.47c2.84 0 5.1-1.15 5.74-4.46.22-1.12.1-2.13-.3-2.98Z"/>
      </svg>
      Dona con PayPal
    </a>
  </div>
  <button
    type="button"
    id="donation-close"
    class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-blue-700/70 hover:bg-blue-100 hover:text-blue-900 dark:text-blue-300/70 dark:hover:bg-blue-900/50 dark:hover:text-blue-100"
    aria-label="Chiudi"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
      <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
    </svg>
  </button>
</div>

<script is:inline>
  // Il banner chiuso resta nascosto per 30 giorni
  (function () {
    var KEY = "donation-dismissed-at";
    var banner = document.getElementById("donation-banner");
    if (!banner) return;
    try {
      var ts = Number(localStorage.getItem(KEY));
      if (ts && Date.now() - ts < 30 * 24 * 60 * 60 * 1000) {
        banner.remove();
        return;
      }
    } catch (e) {}
    document.getElementById("donation-close")?.addEventListener("click", function () {
      banner.remove();
      try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
    });
  })();
</script>
