---
import { Picture } from "astro:assets";
import heroImage from "@/assets/logo/logo.webp";
---

<main class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24 gap-8">
  <!-- Immagine -->
  <div class="py-6 md:order-1 hidden md:block max-w-[280px] mx-auto">
    <Picture
      src={heroImage}
      alt="Logo Appunti Facili"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 280px"
      loading="eager"
      format="avif"
      class="w-full h-auto rounded-lg"
    />
  </div>

  <!-- Testo principale -->
  <div>
    <h1 class="text-5xl lg:text-6xl xl:text-6xl font-bold lg:tracking-tight xl:tracking-tighter">
      Appunti Facili
    </h1>
    <h2 class="text-2xl lg:text-3xl mt-2 font-semibold text-slate-700">
      Appunti di Matematica e Informatica
    </h2>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      <strong>Appunti Facili</strong> è il sito dedicato a <strong>appunti di matematica e informatica</strong>, pensato per studenti di tutti i livelli. Qui troverai appunti chiari, esercizi pratici e risorse utili per approfondire i tuoi studi. 
      Il sito è in continuo aggiornamento: le sezioni mancanti vengono aggiunte su richiesta degli utenti. 
      Non esitare a <a href="/contact" class="text-blue-600 font-semibold underline hover:text-blue-800">contattarmi</a> per suggerimenti o domande.
    </p>
  </div>

</div>
</main>

</section>
