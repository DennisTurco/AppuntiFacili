---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import heroImage from "@/assets/logo/logo.webp";

interface Props {
  stats: { value: number; label: string }[];
}

const { stats } = Astro.props;
---

<section class="grid items-center gap-12 pt-12 pb-16 md:pt-20 lg:grid-cols-[1.3fr_1fr]">
  <div>
    <p class="eyebrow">Appunti gratuiti · aggiornati su richiesta</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl dark:text-white">
      Informatica e matematica,
      <span class="text-blue-600 dark:text-blue-400">spiegate semplici.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
      Appunti chiari, esempi pratici ed esercizi per studenti delle superiori e dell'università.
      Manca un argomento? <a href="/contact" class="link">Chiedilo</a> e lo aggiungo.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/informatica" class="btn btn-lg btn-primary">
        <Icon name="fa6-solid:code" class="h-4 w-4" />
        Appunti di informatica
      </a>
      <a href="/matematica" class="btn btn-lg btn-secondary">
        <Icon name="fa6-solid:square-root-variable" class="h-4 w-4" />
        Appunti di matematica
      </a>
    </div>

    <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4">
      {stats.map((s) => (
        <div>
          <dt class="text-sm text-slate-500 dark:text-slate-400">{s.label}</dt>
          <dd class="font-display text-3xl font-bold text-slate-900 dark:text-white">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="relative mx-auto hidden w-full max-w-sm lg:block">
    <div class="absolute inset-0 -z-10 rounded-full bg-gradient-to-tr from-blue-200 via-sky-100 to-transparent blur-3xl dark:from-blue-900/50 dark:via-sky-900/20"></div>
    <Picture
      src={heroImage}
      alt="Logo Appunti Facili"
      widths={[300, 600]}
      sizes="384px"
      loading="eager"
      formats={["avif", "webp"]}
      class="h-auto w-full rounded-3xl"
    />
  </div>
</section>
