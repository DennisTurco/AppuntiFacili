---
import { Icon } from "astro-icon/components";

interface Props {
  variant: "tip" | "warning" | "danger" | "info";
  title?: string;
}

const { variant, title} = Astro.props as Props;


const iconName = {
  tip: "fa6-solid:lightbulb",
  warning: "fa6-solid:triangle-exclamation",
  danger: "fa6-solid:fire",
  info: "fa6-solid:circle-info",
}[variant];

const ariaLabel = title || variant.charAt(0).toUpperCase() + variant.slice(1);
---

<div
  role="note"
  aria-label={ariaLabel}
  class:list={[
    "aside prose-p:my-0 my-3 rounded-md border-l-4 px-4 py-3",
    {
      " [&>p>code]:prose-code:bg-green-400/20 border-green-400 bg-green-400/10 text-green-950":
        variant === "tip",
      " [&>p>code]:prose-code:bg-yellow-400/20 border-yellow-400 bg-yellow-400/10 text-yellow-950":
        variant === "warning",
      " [&>p>code]:prose-code:bg-red-400/20 border-red-400 bg-red-400/10 text-red-950":
        variant === "danger",
      " [&>p>code]:bg-sky-400/20 border-sky-400 bg-sky-400/10 text-sky-950":
        variant === "info",
    },
  ]}
>
  <div class="flex items-center gap-2 pb-2">
    <Icon name={iconName} class="h-6 w-6" aria-hidden="true" />
    <p class="text-sm font-bold uppercase tracking-wide">
      {title || variant.toUpperCase()}
    </p>
  </div>
  <slot />
</div>
