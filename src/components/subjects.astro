---
import { Icon } from "astro-icon/components";
import { categoryMeta } from "@/utils/lessons";

interface Subject {
  title: string;
  href: string;
  icon: string;
  description: string;
  count: number;
  categories: string[];
}

interface Props {
  subjects: Subject[];
}

const { subjects } = Astro.props;
---

<section aria-labelledby="subjects-title">
  <h2 id="subjects-title" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
    Scegli una materia
  </h2>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    {subjects.map((s) => (
      <a href={s.href} class="card card-hover group flex flex-col p-6 sm:p-8">
        <div class="flex items-start justify-between gap-4">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
            <Icon name={s.icon} class="h-6 w-6" />
          </span>
          <span class="badge bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
            {s.count} lezioni
          </span>
        </div>
        <h3 class="mt-5 text-2xl font-bold text-slate-900 dark:text-white">{s.title}</h3>
        <p class="mt-2 text-slate-600 dark:text-slate-400">{s.description}</p>
        <ul class="mt-5 flex flex-wrap gap-1.5">
          {s.categories.slice(0, 8).map((c) => (
            <li class="badge bg-slate-50 text-slate-600 ring-1 ring-inset ring-slate-200 dark:bg-slate-800/60 dark:text-slate-300 dark:ring-slate-700">
              {categoryMeta(c).label}
            </li>
          ))}
          {s.categories.length > 8 && (
            <li class="badge text-slate-500 dark:text-slate-400">+{s.categories.length - 8}</li>
          )}
        </ul>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 dark:text-blue-400">
          Vai agli appunti
          <Icon name="fa6-solid:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
        </span>
      </a>
    ))}
  </div>
</section>
