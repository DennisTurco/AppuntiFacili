---
import { Icon } from "astro-icon/components";
import AuthorizedVideos from "@/components/AuthorizedVideos.jsx";
---

<div class="mx-auto max-w-5xl py-12 md:py-16">
  <header class="max-w-2xl">
    <p class="eyebrow">Area riservata</p>
    <h1 class="page-title mt-2">Video lezioni</h1>
    <p class="page-subtitle">
      Le registrazioni delle lezioni sono private: accedi con il tuo account per vedere quelle a cui sei abilitato.
    </p>
  </header>

  <div class="callout mt-8 grid gap-3 sm:grid-cols-3">
    <p class="flex items-start gap-2 text-sm">
      <Icon name="fa6-solid:lock" class="mt-0.5 h-4 w-4 shrink-0 text-blue-600 dark:text-blue-400" />
      <span>Per richiedere l'accesso a un video <a href="/contact" class="link">contattami</a>.</span>
    </p>
    <p class="flex items-start gap-2 text-sm">
      <Icon name="fa6-solid:video" class="mt-0.5 h-4 w-4 shrink-0 text-blue-600 dark:text-blue-400" />
      <span>Vuoi un video che non c'è? <a href="/contact" class="link">Chiedilo</a> e lo aggiungo.</span>
    </p>
    <p class="flex items-start gap-2 text-sm">
      <Icon name="fa6-brands:github" class="mt-0.5 h-4 w-4 shrink-0 text-blue-600 dark:text-blue-400" />
      <span>
        I programmi delle lezioni sono su
        <a target="_blank" rel="noopener noreferrer" href="https://github.com/DennisTurco/AppuntiLezioni" class="link">GitHub</a>.
      </span>
    </p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <AuthorizedVideos client:load />
  </div>
</div>
