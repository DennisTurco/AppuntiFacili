---
const { url, title, icon } = Astro.props;
---

<a
  href={url}
  class="group block rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-50 to-gray-100 p-6 shadow-sm transition transform hover:-translate-y-1 hover:shadow-lg hover:border-blue-300"
>
  <div class="flex items-center gap-3">
    <span class="text-2xl">{icon}</span>
    <h2 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
      {title}
    </h2>
  </div>
  <p class="mt-3 text-gray-700 text-sm">
    Appunti e risorse su {title.toLowerCase()}.
  </p>
</a>
