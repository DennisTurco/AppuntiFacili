---
/**
 * Ricerca globale (lezioni e blog) con Pagefind.
 * L'indice viene generato dopo la build (`astro build && pagefind --site dist`):
 * in sviluppo serve `pnpm search:dev` per crearlo in public/pagefind.
 */
import { Icon } from "astro-icon/components";

interface Props {
  /** Solo icona (barra mobile) */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{
  compact ? (
    <button
      type="button"
      data-search-open
      class="inline-flex rounded-lg p-2 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
      aria-label="Cerca negli appunti"
      title="Cerca"
    >
      <Icon name="fa6-solid:magnifying-glass" class="h-5 w-5" />
    </button>
  ) : (
    <button
      type="button"
      data-search-open
      class="inline-flex h-9 w-52 items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm text-slate-500 transition-colors hover:border-slate-300 hover:bg-white hover:text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:border-slate-700 dark:hover:text-slate-200"
      aria-label="Cerca negli appunti"
    >
      <Icon name="fa6-solid:magnifying-glass" class="h-3.5 w-3.5" />
      <span class="flex-1 text-left">Cerca...</span>
      <kbd data-search-shortcut class="rounded border border-slate-200 bg-white px-1.5 font-sans text-[0.7rem] font-medium text-slate-400 dark:border-slate-700 dark:bg-slate-800">
        Ctrl K
      </kbd>
    </button>
  )
}

<script>
  type Result = {
    url: string;
    excerpt: string;
    meta: { title?: string; categoria?: string };
    filters: { sezione?: string[] };
    sub_results?: { title: string; url: string; excerpt: string }[];
  };

  const SECTIONS = ["Tutto", "Informatica", "Matematica", "Blog"] as const;
  let pagefind: any = null;
  let dialog: HTMLDialogElement | null = null;
  let section: (typeof SECTIONS)[number] = "Tutto";
  let active = -1;

  const escapeHtml = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  async function loadPagefind() {
    if (pagefind) return pagefind;
    // URL calcolato: Vite non deve provare a risolverlo in fase di build
    const url = "/pagefind/pagefind.js";
    pagefind = await import(/* @vite-ignore */ url);
    await pagefind.options({ excerptLength: 18 });
    pagefind.init();
    return pagefind;
  }

  function createDialog(): HTMLDialogElement {
    const d = document.createElement("dialog");
    d.id = "search-dialog";
    d.setAttribute("aria-label", "Cerca negli appunti");
    d.className =
      "search-dialog m-0 mx-auto mt-[8vh] w-[calc(100%-2rem)] max-w-2xl overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/50 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100";
    d.innerHTML = `
      <div class="flex items-center gap-3 border-b border-slate-200 px-4 dark:border-slate-800">
        <svg viewBox="0 0 512 512" class="h-4 w-4 shrink-0 text-slate-400" aria-hidden="true"><path fill="currentColor" d="M416 208c0 45.9-14.9 88.3-40 122.7l126.6 126.7c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0s208 93.1 208 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"/></svg>
        <input data-search-input type="search" placeholder="Cerca lezioni, argomenti, esempi..." autocomplete="off" spellcheck="false"
          class="h-14 flex-1 bg-transparent text-base outline-none placeholder:text-slate-400" aria-controls="search-results" />
        <button type="button" data-search-close class="rounded-md border border-slate-200 px-1.5 py-0.5 text-xs text-slate-500 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800" aria-label="Chiudi">Esc</button>
      </div>
      <div data-search-filters class="flex flex-wrap gap-1.5 border-b border-slate-200 px-4 py-2 dark:border-slate-800" role="radiogroup" aria-label="Sezione">
        ${SECTIONS.map((s) => `<button type="button" role="radio" data-section="${s}" class="search-chip">${s}</button>`).join("")}
      </div>
      <div data-search-status class="px-4 py-6 text-center text-sm text-slate-500 dark:text-slate-400">Scrivi per cercare in tutti gli appunti.</div>
      <ul id="search-results" data-search-results role="listbox" class="max-h-[60vh] overflow-y-auto p-2"></ul>
    `;
    document.body.appendChild(d);

    const input = d.querySelector<HTMLInputElement>("[data-search-input]")!;
    input.addEventListener("input", () => search(input.value));
    input.addEventListener("keydown", onKeyDown);
    d.querySelector("[data-search-close]")!.addEventListener("click", () => d.close());
    d.addEventListener("click", (e) => {
      if (e.target === d) d.close(); // click sullo sfondo
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-section]");
      if (chip) {
        section = chip.dataset.section as typeof section;
        syncChips();
        search(input.value);
        input.focus();
      }
    });
    syncChips();
    return d;
  }

  function syncChips() {
    dialog?.querySelectorAll<HTMLButtonElement>("[data-section]").forEach((chip) => {
      chip.setAttribute("aria-checked", String(chip.dataset.section === section));
    });
  }

  function setActive(index: number) {
    const items = [...(dialog?.querySelectorAll<HTMLElement>("[data-search-item]") ?? [])];
    if (!items.length) return;
    active = (index + items.length) % items.length;
    items.forEach((item, i) => item.setAttribute("aria-selected", String(i === active)));
    items[active].scrollIntoView({ block: "nearest" });
  }

  function onKeyDown(e: KeyboardEvent) {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === "Enter") {
      const item = dialog?.querySelectorAll<HTMLAnchorElement>("[data-search-item]")[Math.max(active, 0)];
      if (item) {
        e.preventDefault();
        item.click();
      }
    }
  }

  function renderResults(results: Result[], query: string) {
    const list = dialog!.querySelector("[data-search-results]")!;
    const status = dialog!.querySelector<HTMLElement>("[data-search-status]")!;
    active = -1;
    if (!results.length) {
      list.innerHTML = "";
      status.hidden = false;
      status.textContent = `Nessun risultato per “${query}”.`;
      return;
    }
    status.hidden = true;
    list.innerHTML = results
      .map((r) => {
        // Se il risultato è in una sezione specifica della pagina, punta direttamente al titolo
        const sub = r.sub_results?.find((s) => s.url.includes("#"));
        const url = sub?.url ?? r.url;
        const where = [r.filters.sezione?.[0], r.meta.categoria].filter(Boolean).join(" · ");
        return `<li>
          <a href="${escapeHtml(url)}" data-search-item role="option" aria-selected="false" class="search-item block rounded-lg px-3 py-2.5">
            <span class="flex items-baseline justify-between gap-3">
              <span class="font-semibold text-slate-900 dark:text-white">${escapeHtml(r.meta.title ?? url)}${sub && sub.title !== r.meta.title ? `<span class="font-normal text-slate-500 dark:text-slate-400"> › ${escapeHtml(sub.title)}</span>` : ""}</span>
              <span class="shrink-0 text-xs text-slate-400">${escapeHtml(where)}</span>
            </span>
            <span class="search-excerpt mt-0.5 block text-sm text-slate-600 dark:text-slate-400">${sub?.excerpt ?? r.excerpt}</span>
          </a>
        </li>`;
      })
      .join("");
    setActive(0);
  }

  async function search(query: string) {
    const status = dialog!.querySelector<HTMLElement>("[data-search-status]")!;
    const list = dialog!.querySelector("[data-search-results]")!;
    if (!query.trim()) {
      list.innerHTML = "";
      status.hidden = false;
      status.textContent = "Scrivi per cercare in tutti gli appunti.";
      return;
    }
    let pf;
    try {
      pf = await loadPagefind();
    } catch {
      status.hidden = false;
      status.textContent = "Indice di ricerca non disponibile (in sviluppo: esegui pnpm search:dev).";
      return;
    }
    const filters = section === "Tutto" ? {} : { sezione: section };
    const result = await pf.debouncedSearch(query, { filters }, 150);
    if (result === null) return; // superata da una ricerca più recente
    const data: Result[] = await Promise.all(result.results.slice(0, 12).map((r: any) => r.data()));
    renderResults(data, query);
  }

  function open() {
    dialog ??= createDialog();
    if (dialog.open) return;
    dialog.showModal();
    const input = dialog.querySelector<HTMLInputElement>("[data-search-input]")!;
    input.select();
    loadPagefind().catch(() => {});
  }

  // Registrati una volta sola: funzionano anche dopo le View Transitions
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-search-open]")) open();
    // Chiude la finestra quando si apre un risultato
    if ((e.target as HTMLElement).closest("[data-search-item]")) dialog?.close();
  });
  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    const typing = target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName);
    if ((e.key === "k" && (e.ctrlKey || e.metaKey)) || (e.key === "/" && !typing)) {
      e.preventDefault();
      open();
    }
  });
  // Il dialog è aggiunto al body: dopo una View Transition il body è nuovo
  document.addEventListener("astro:after-swap", () => {
    dialog = null;
  });
  document.addEventListener("astro:page-load", () => {
    if (/Mac|iPhone|iPad/.test(navigator.platform)) {
      document.querySelectorAll("[data-search-shortcut]").forEach((k) => (k.textContent = "⌘ K"));
    }
  });
</script>

<style is:global>
  .search-chip {
    border: 1px solid var(--color-slate-200);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-slate-600);
    cursor: pointer;
  }
  .search-chip:hover {
    background: var(--color-slate-100);
  }
  .search-chip[aria-checked="true"] {
    border-color: var(--color-blue-600);
    background: var(--color-blue-600);
    color: #fff;
  }
  .dark .search-chip {
    border-color: var(--color-slate-700);
    color: var(--color-slate-300);
  }
  .dark .search-chip:hover {
    background: var(--color-slate-800);
  }
  .dark .search-chip[aria-checked="true"] {
    border-color: var(--color-blue-500);
    background: var(--color-blue-600);
    color: #fff;
  }
  .search-item[aria-selected="true"],
  .search-item:hover {
    background: var(--color-slate-100);
  }
  .dark .search-item[aria-selected="true"],
  .dark .search-item:hover {
    background: var(--color-slate-800);
  }
  .search-excerpt mark {
    background: transparent;
    color: var(--color-blue-700);
    font-weight: 600;
  }
  .dark .search-excerpt mark {
    color: var(--color-blue-300);
  }
  .search-dialog[open] {
    animation: search-in 0.12s ease-out;
  }
  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open] {
      animation: none;
    }
  }
</style>
