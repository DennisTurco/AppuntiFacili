---
---

<!-- Form gestito da https://web3forms.com/ -->
<form action="https://api.web3forms.com/submit" method="POST" id="contact-form" class="space-y-5" novalidate>
  <input type="hidden" name="access_key" value="91280369-2293-46c0-a34f-1c452d54da17" />
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class="label">Nome e cognome</label>
      <input id="cf-name" type="text" name="name" required autocomplete="name" class="input" />
      <p class="field-error">Inserisci il tuo nome.</p>
    </div>
    <div>
      <label for="cf-email" class="label">Email</label>
      <input id="cf-email" type="email" name="email" required autocomplete="email" placeholder="nome@esempio.it" class="input" />
      <p class="field-error">Inserisci un indirizzo email valido.</p>
    </div>
  </div>

  <div>
    <label for="cf-type" class="label">Tipo di richiesta</label>
    <select id="cf-type" name="Tipo di richiesta" required class="input">
      <option value="" disabled selected>Seleziona...</option>
      <option value="richiesta_generica">Richiesta generica</option>
      <option value="segnalazione_problema">Segnalazione di un problema</option>
      <option value="richiesta_lezione">Richiesta di lezione</option>
      <option value="aggiunta_argomento">Richiesta aggiunta argomento</option>
      <option value="modifica_argomento">Richiesta modifica argomento</option>
      <option value="richiesta_video_lezione">Richiesta video lezione</option>
      <option value="recupero_account">Richiesta di recupero account</option>
      <option value="altro">Altro</option>
    </select>
    <p class="field-error">Seleziona un tipo di richiesta.</p>
  </div>

  <div>
    <label for="cf-message" class="label">Messaggio</label>
    <textarea id="cf-message" name="message" required rows="6" class="input resize-y"></textarea>
    <p class="field-error">Scrivi il tuo messaggio.</p>
  </div>

  <button type="submit" class="btn btn-lg btn-primary w-full">Invia messaggio</button>

  <p id="contact-result" class="hidden rounded-lg px-4 py-3 text-center text-sm" role="status"></p>
</form>

<style>
  @reference "../styles/global.css";

  .field-error {
    @apply mt-1 hidden text-sm text-red-600 dark:text-red-400;
  }
  .was-validated :invalid {
    @apply border-red-500 dark:border-red-500;
  }
  .was-validated :invalid + .field-error {
    display: block;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const result = document.getElementById("contact-result");
    if (!form || !result) return;

    const showResult = (message: string, ok: boolean) => {
      result.textContent = message;
      result.className = ok
        ? "rounded-lg bg-emerald-50 px-4 py-3 text-center text-sm text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300"
        : "rounded-lg bg-red-50 px-4 py-3 text-center text-sm text-red-800 dark:bg-red-950/50 dark:text-red-300";
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      form.classList.add("was-validated");
      if (!form.checkValidity()) return;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.textContent = "Invio in corso...";
      }

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const json = await response.json();
        if (response.ok) {
          showResult("Messaggio inviato! Ti risponderò il prima possibile.", true);
          form.reset();
          form.classList.remove("was-validated");
        } else {
          showResult(json.message ?? "Errore nell'invio del messaggio, riprova più tardi.", false);
        }
      } catch (error) {
        console.error(error);
        showResult("Errore nell'invio del messaggio, riprova più tardi.", false);
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = "Invia messaggio";
        }
      }
    });
  });
</script>
