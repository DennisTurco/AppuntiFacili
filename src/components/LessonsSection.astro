---
import { getCollection } from "astro:content";
import { getFormattedDate } from "@/utils/all";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

interface Props {
  collection: "matematica" | "informatica";
  title: string;
  categoriesOrder: string[];
  icons: Record<string, string>;
  basePath: string;
  githubbutton: boolean;
}

const { collection, title, categoriesOrder, icons, basePath, githubbutton } = Astro.props;

// Mappa di funzioni per collezione
const collectionMap = {
  matematica: () =>
    getCollection("matematica", ({ data }) => !data.draft && data.lastUpdateDate < new Date()),
  informatica: () =>
    getCollection("informatica", ({ data }) => !data.draft && data.lastUpdateDate < new Date()),
};

// Recupera la collezione corrispondente
let entries = await collectionMap[collection]();

entries = entries.sort((a, b) => a.slug.localeCompare(b.slug, undefined, { numeric: true }));

type LessonEntry = (typeof entries)[number];
type ByCategory = Record<string, LessonEntry[]>;

const byCategory: ByCategory = entries.reduce((acc, entry) => {
  const [cat] = entry.slug.split("/");
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(entry);
  return acc;
}, {} as ByCategory);
---

<Container>
  <div class="container mx-auto px-4 sm:px-6 lg:px-12 py-12 space-y-8 max-w-7xl">
    <h1 class="text-3xl font-bold text-center mb-4">Appunti di {title}</h1>

    <!-- Descrizione -->
    <div class="bg-blue-100 border border-blue-300 rounded-xl p-4 text-center">
      <p class="text-gray-800 text-lg">
        Non sono presenti tutte le lezioni, ma se manca qualcosa
        <a href="/contact" class="text-blue-600 font-semibold underline hover:text-blue-800">
          contattami
        </a>
        e la aggiungo!
      </p>

      {githubbutton ? (
        <p class="text-gray-800 text-lg mt-2">
          Tutti i programmi delle lezioni su:
          <a
            target="_blank"
            href="https://github.com/DennisTurco/AppuntiLezioni"
            class="inline-flex items-center gap-2 bg-blue-600 text-white font-semibold px-4 py-2 rounded-lg shadow-md hover:bg-blue-700 hover:scale-105 transition ml-2"
          >
            <Icon name="fa6-brands:github" class="text-white text-xl" />
            <span>GitHub</span>
          </a>
        </p>
      ) : null}
    </div>

    <!-- Campo di ricerca -->
    <div class="flex flex-col sm:flex-row gap-3 mb-6 items-center">
      <input
        type="text"
        id="lessonFilter"
        placeholder="🔍 Cerca una lezione..."
        class="w-full sm:flex-1 px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      <select
        id="languageFilter"
        class="px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="">Tutte le categorie</option>
        {Object.keys(byCategory).map((cat) => (
          <option value={cat}>{cat.toUpperCase()}</option>
        ))}
      </select>
    </div>

    <!-- Pulsante espandi/comprimi -->
    <div class="flex justify-between items-center mb-2">
      <p class="text-sm text-gray-500">
        Totale lezioni: <strong>{entries.length}</strong>
      </p>
      <button
        id="toggleAll"
        class="px-3 py-1 bg-blue-500 text-white rounded-md text-sm hover:bg-blue-600 transition"
      >
        Espandi/Comprimi tutti
      </button>
    </div>

<!-- Sezione lezioni -->
<div id="lessonList" class="space-y-4 mt-4">
  {categoriesOrder.map((category) => {
    const lessons = byCategory[category];
    if (!lessons) return null;

    return (
      <details
        class="bg-gray-50 rounded-lg border border-gray-200 p-3 lesson-group"
        data-lang={category}
        open
      >
        <summary class="cursor-pointer text-lg font-semibold flex items-center gap-2">
          <Icon name={icons[category] || "fa6-solid:book"} class="text-gray-700" />
          <span class="uppercase">{category}</span>
          <span class="ml-auto text-sm text-gray-500">({lessons.length} lezioni)</span>
        </summary>

        <div class="mt-2">
          <!-- Intestazione tabella (solo su desktop) -->
          <div class="hidden sm:grid grid-cols-3 font-semibold text-gray-600 text-sm border-b pb-1 mb-1">
            <span>Lezione</span>
            <span class="text-center">Difficoltà</span>
            <span class="text-right">Ultima modifica</span>
          </div>

          <ul class="divide-y divide-gray-100">
            {lessons.map((lesson) => (
              <li class="lesson-item grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-4 py-2 items-center hover:bg-gray-100/60 transition rounded-md px-1">
                <!-- Titolo -->
                <a
                  href={`${basePath}/${lesson.slug}`}
                  class="text-blue-600 hover:underline truncate font-medium"
                >
                  {lesson.data.title || lesson.slug}
                </a>

                <!-- Difficoltà -->
                <span class="text-sm text-gray-700 sm:text-center sm:block">
                  {lesson.data.difficulty || "N/D"}
                </span>

                <!-- Ultima modifica -->
                <span class="text-xs text-gray-500 sm:text-right sm:block">
                  {lesson.data.lastUpdateDate?.toLocaleDateString("it-IT") || ""}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </details>
    );
  })}

  {Object.keys(byCategory)
    .filter((k) => !categoriesOrder.includes(k))
    .sort()
    .map((extra) => (
      <details
        class="bg-gray-50 rounded-lg border border-gray-200 p-3 lesson-group"
        data-lang={extra}
      >
        <summary class="cursor-pointer text-lg font-semibold flex items-center gap-2">
          <Icon name="fa6-solid:book" class="text-gray-700" />
          <span class="uppercase">{extra}</span>
          <span class="ml-auto text-sm text-gray-500">
            ({byCategory[extra].length} lezioni)
          </span>
        </summary>
        <ul class="list-disc pl-6 space-y-1 mt-2">
          {byCategory[extra].map((lesson) => (
            <li class="lesson-item">
              <a
                href={`${basePath}/${lesson.slug}`}
                class="text-blue-600 hover:underline"
              >
                {lesson.data.title || lesson.slug}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
</div>

      {Object.keys(byCategory)
        .filter((k) => !categoriesOrder.includes(k))
        .sort()
        .map((extra) => (
          <details
            class="bg-gray-50 rounded-lg border border-gray-200 p-3 lesson-group"
            data-lang={extra}
          >
            <summary class="cursor-pointer text-lg font-semibold flex items-center gap-2">
              <Icon name="fa6-solid:book" class="text-gray-700" />
              <span class="uppercase">{extra}</span>
              <span class="ml-auto text-sm text-gray-500">
                ({byCategory[extra].length} lezioni)
              </span>
            </summary>
            <ul class="list-disc pl-6 space-y-1 mt-2">
              {byCategory[extra].map((lesson) => (
                <li class="lesson-item">
                  <a
                    href={`${basePath}/${lesson.slug}`}
                    class="text-blue-600 hover:underline"
                  >
                    {lesson.data.title || lesson.slug}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}

        <p class="text-right text-sm text-gray-500 mt-6">
          Ultimo aggiornamento: {getFormattedDate(new Date())}
        </p>

        {/* SEZIONE LIBRI CONSIGLIATI SOLO PER INFORMATICA */}
      {collection === "informatica" && (
        <section class="bg-gray-50 border border-gray-200 rounded-xl p-6 mt-10">
          <h2 class="text-2xl font-bold mb-4">Libri consigliati</h2>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <a
                href="https://github.com/DennisTurco/clean-code-summary"
                target="_blank"
                class="text-blue-600 hover:underline"
              >
                Clean Code Summary (English Version)
              </a>
            </li>
            <li>
              <a
                href="https://automatetheboringstuff.com/"
                target="_blank"
                class="text-blue-600 hover:underline"
              >
                Automate the Boring Stuff with Python
              </a>
            </li>
            <li>
              <a
                href="https://github.com/EbookFoundation/free-programming-books/blob/main/books/free-programming-books-langs.md"
                target="_blank"
                class="text-blue-600 hover:underline"
              >
                Free Programming Books
              </a>
            </li>
          </ul>
        </section>
      )}
    </div>

        
    </div>
  </div>

  <script src="../utils/lesson-filter.js"></script>
</Container>
