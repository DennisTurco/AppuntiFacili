---
import Layout from "@/layouts/Layout.astro";
import LessonsSection from "@/components/LessonsSection.astro";

const categoriesOrder = [
  "numeri",
  "polinomi",
  "equazioni",
  "logaritmi",
  "limiti",
  "derivate",
  "altro",
];

const icons = {
  numeri: "fa6-solid:hashtag",
  polinomi: "fa6-solid:superscript",
  equazioni: "fa6-solid:equals",
  logaritmi: "fa6-solid:subscript",
  limiti: "fa6-solid:infinity",
  derivate: "fa6-solid:chart-line",
  altro: "fa6-solid:bookmark",
};
---

<Layout title="Appunti di Matematica">
  <LessonsSection
    collection="matematica"
    title="Matematica"
    categoriesOrder={categoriesOrder}
    icons={icons}
    basePath="/matematica"
    githubbutton={true}
  />
</Layout>
