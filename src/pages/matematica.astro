---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

// Ottieni tutte le lezioni pubblicate
let entries = await getCollection("matematica", ({ data }) => {
  return !data.draft && data.lastUpdateDate < new Date();
});

// Ordina per numero nel nome file (slug)
entries = entries.sort((a, b) => {
  return a.slug.localeCompare(b.slug, undefined, { numeric: true });
});

// Tipi
type LessonEntry = typeof entries[number];
type ByLanguage = Record<string, LessonEntry[]>;

// Raggruppa per linguaggio in base allo slug
const byLanguage: ByLanguage = entries.reduce((acc, entry) => {
  const [lang] = entry.slug.split("/");
  if (!acc[lang]) acc[lang] = [];
  acc[lang].push(entry);
  return acc;
}, {} as ByLanguage);
---

<Layout title="Matematica">
  <Container>

    <div class="container mx-auto px-6 py-12 space-y-8">
  <h1 class="text-3xl font-bold text-center mb-4">Lezioni matematica</h1>

<!-- Descrizione -->
<div class="bg-blue-100 border border-blue-300 rounded-xl p-4 text-center">
  <p class="text-gray-800 text-lg">
    Ci tengo a precisare che non sono presenti tutte le lezioni, se manca qualcosa che vi serve, non esitate a
    <a href="/contact" class="text-blue-600 font-semibold underline hover:text-blue-800">
      contattarmi
    </a>
    e aggiungo!
  </p>
</div>

      <!-- Layout principale con flex -->
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Contenuto principale: lezioni -->

          {Object.entries(byLanguage || {}).map(([category, lessons]) => (
          <div>
            <h3 class="text-xl font-semibold flex items-center gap-2 mt-4">
              {category === "numeri" && <Icon name="fa6-solid:bookmark" class="text-gray-700" />}
              <span class="uppercase">{category}</span>
            </h3>
            <ul class="list-disc pl-6 space-y-2">
              {lessons.map((lesson) => (
                <li>
                  <a href={`/matematica/${lesson.slug}`} class="text-blue-600 hover:underline">
                    {lesson.data.title || lesson.slug}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        </div>
    </div>
  </Container>
</Layout>
