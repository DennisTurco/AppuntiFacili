---
import Layout from "@/layouts/Layout.astro";
import LessonsSection from "@/components/LessonsSection.astro";

const categoriesOrder = [
  "numeri",
  "polinomi",
  "equazioni",
  "logaritmi",
  "limiti",
  "derivate",
  "altro",
];

const description =
  "Teoria, esempi svolti ed esercizi di matematica: dai numeri e polinomi fino a limiti e derivate.";
---

<Layout title="Appunti di Matematica" description={description}>
  <LessonsSection
    collection="matematica"
    title="Matematica"
    description={description}
    categoriesOrder={categoriesOrder}
  />
</Layout>
