---
import Layout from "@/layouts/Layout.astro";
import LessonsSection from "@/components/LessonsSection.astro";

const categoriesOrder = [
  "python",
  "c",
  "cpp",
  "java",
  "csharp",
  "html",
  "sql",
  "algorithms-and-data-structures",
];

const icons = {
  c: "fa6-solid:bookmark",
  cpp: "fa6-solid:bookmark",
  java: "fa6-brands:java",
  python: "fa6-brands:python",
  sql: "fa6-solid:database",
  html: "fa6-brands:html5",
  csharp: "fa6-solid:hashtag",
  "algorithms-and-data-structures": "fa6-solid:diagram-project",
};
---

<Layout title="Appunti di Informatica">
  <LessonsSection
    collection="informatica"
    title="Informatica"
    categoriesOrder={categoriesOrder}
    icons={icons}
    basePath="/informatica"
  />
</Layout>
