---
import Layout from "@/layouts/Layout.astro";
import LessonsSection from "@/components/LessonsSection.astro";

const categoriesOrder = [
  "varie",
  "python",
  "c",
  "cpp",
  "java",
  "csharp",
  "typescript",
  "html",
  "sql",
  "postgresql",
  "php",
  "web-api",
  "dev-practices",
  "algorithms-and-data-structures",
];

const description =
  "Linguaggi di programmazione, database, algoritmi e buone pratiche di sviluppo, con esempi di codice pronti da provare.";
---

<Layout title="Appunti di Informatica" description={description}>
  <LessonsSection
    collection="informatica"
    title="Informatica"
    description={description}
    categoriesOrder={categoriesOrder}
    githubbutton
  />
</Layout>
