---
import { getCollection } from "astro:content";
import MatematicaLayout from "@/layouts/MatematicaLayout.astro";
import { sidebar } from "@/data/sidebarMatematica.ts";

export async function getStaticPaths() {
  const entries = await getCollection("matematica");
  return entries.map(e => ({
    params: { slug: e.slug },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const frontmatter = {
  title: entry.data.title,
  lastUpdateDate: entry.data.lastUpdateDate,
  subject: entry.data.subject,
  category: entry.data.category,
  author: entry.data.author,
  tags: entry.data.tags,
  videoLesson: entry.data.videoLesson,
  url: `/matematica/${entry.slug}`,
};
---

<MatematicaLayout {frontmatter} lessons={sidebar}  {...entry.data}>
  <Content />
</MatematicaLayout>
