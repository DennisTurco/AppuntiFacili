---
import { getCollection } from "astro:content";
import LessonLayout from "@/layouts/LessonLayout.astro";
import Quiz from "@/components/Quiz.jsx";
import Aside from "@/components/Aside.astro";
import Playground from "@/components/Playground.astro";
import CodeQuiz from "@/components/CodeQuiz.astro";

export async function getStaticPaths() {
  const entries = await getCollection("informatica");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
---

<LessonLayout entry={entry} headings={headings} collection="informatica">
  <Content components={{ Quiz, Aside, Playground, CodeQuiz }} />
</LessonLayout>
