---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Pagina non trovata">
  <Container>
    <div class="flex min-h-[60vh] items-center justify-center py-16">
      <div class="text-center">
        <p class="font-display text-7xl font-bold text-blue-600 dark:text-blue-400">404</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Pagina non trovata</h1>
        <p class="mt-3 text-slate-600 dark:text-slate-400">
          La pagina che cerchi non esiste o è stata spostata.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn btn-lg btn-primary">
            <Icon name="fa6-solid:house" class="h-4 w-4" />
            Torna alla home
          </a>
          <a href="/informatica" class="btn btn-lg btn-secondary">Informatica</a>
          <a href="/matematica" class="btn btn-lg btn-secondary">Matematica</a>
        </div>

        <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
          Pensi sia un errore?
          <a id="report-link" href="https://github.com/DennisTurco/AppuntiFacili/issues/new" target="_blank" rel="noopener noreferrer" class="link">
            Segnalalo su GitHub
          </a>
        </p>
        <script is:inline>
          (function () {
            var link = document.getElementById("report-link");
            if (link) {
              link.href =
                "https://github.com/DennisTurco/AppuntiFacili/issues/new?title=404+Page+Not+Found&body=" +
                encodeURIComponent("Pagina 404 in URL: " + window.location.href);
            }
          })();
        </script>
      </div>
    </div>
  </Container>
</Layout>
